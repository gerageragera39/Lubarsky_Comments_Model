# API ключ YouTube Data API v3
# Получить: https://console.cloud.google.com/apis/credentials
API_KEY=your_youtube_api_key_here

# Путь к файлу датасета (внутри контейнера)
DATASET_FILE=/app/dataset.csv

# Путь к файлу сессии (внутри контейнера)
SESSION_FILE=/app/session.json

# Максимальное количество комментариев для загрузки
MAX_COMMENTS=500

# Installation note for Windows with CUDA:
# pip install -r requirements.txt --index-url https://download.pytorch.org/whl/cu121
